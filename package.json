{
  "name": "mesoquick-frontend-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo 'Monorepo initialized. Run apps individually or add Turborepo.' && sleep infinity",
    "dev:empresas": "npm run dev -w @mesoquick/app-empresas",
    "dev:repartidores": "npm run dev -w @mesoquick/app-repartidores"
  }
}
