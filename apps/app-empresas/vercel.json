{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://broker-services-production.up.railway.app/api/:path*"
    },
    {
      "source": "/business-api/:path*",
      "destination": "https://proyectoarqui.onrender.com/api/:path*"
    },
    {
      "source": "/logistica-api/:path*",
      "destination": "https://modulo-logistica.fly.dev/api/:path*"
    },
    {
      "source": "/((?!api|business-api|logistica-api).*)",
      "destination": "/index.html"
    }
  ]
}
